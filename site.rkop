shorthand is accepted;

<<>> {
    : EnableProfiler() 
    & Route("GET /static") : Fileserver(f"static")
    | ExactRoute("GET /") : InformationMessage("DT") : <"@ Desktop">
    | Route("GET /fs") : tpl(t"skeleton.html") {
        |~ "content" : <"@ Explorer">;
    }
    | Route("GET /pls") : tpl(t"mp-skeleton.html") {
        |~ "items" : MpvPlaylist("Playlist Items") :? "file" : Info() {
            :? "type" :~ "dir" {
                |? "path" : AtomicMetadata(cache = true) : PerformerMetadata("First Performer") :! "artist" : tpl(t"mp-item.html");
                :? "name" :! "title" : Register("Queued Directory") :! "album" : tpl(t"mp-item.html");
            };
        };
    }
    | Route("GET /tnd") : tpl(t"thumbnail-skel.html") {
        |~ "content" : <"@ Directory Thumbnail">;
    }
    | Route("GET /tnf") : tpl(t"thumbnail-skel.html") {
        |~ "content" : <"@ File Thumbnail">;
    }
    | Route("POST /endqueue") : <"@ Append to End of Queue">
    | Route("POST /insertqueue") : <"@ Insert after Current">
    | Route("POST /overridequeue") : <"@ Replace Queue">

    | Route("GET /ol") : MpvPropertyGet("osd-level") :! "osd-level" :$ "{% &osd-level %}"
    | Route("GET /ols") : Register(2) : MpvPropertySet("osd-level")

    | Route("GET /pause") { : reg("yes") : MpvPropertySet("pause") & fredir("/mpctrl"); }
    | Route("GET /resume") { : reg("no") : MpvPropertySet("pause") & fredir("/mpctrl"); }
    | Route("GET /next") { : MpvCommand("playlist-next") & fredir("/mpctrl") & Register("yes") : MpvPropertySet("fullscreen") ; }
    | Route("GET /prev") { : MpvCommand("playlist-prev") & fredir("/mpctrl") & Register("yes") : MpvPropertySet("fullscreen") ; }
    | Route("GET /vol/{$vol$}") { :? "vol" : MpvPropertySet("ao-volume") & fredir("/mpctrl"); }
    | Route("GET /pos/{$pos$}") { :? "pos" : MpvPropertySet("percent-pos") & fredir("/mpctrl"); }

    | Route("GET /mpctrl") : tpl(t"mp-playback-frame.html") { | <"@ Playback Controls">; }
    | Route("GET /justcontrols") : <"@ Playback Controls">
    | Route("GET /volbar") : <"@ Volume Bar">
    | Route("GET /posbar") : <"@ Position Bar">
    | Route("GET /plpabtn") : <"@ Play Pause Button">
    | Route("GET /currenttitle") : MpvPropertyGet("media-title") :! "mt" :$ "{% &mt %}"
    | Route("GET /idle") : MpvPropertyGet("core-idle") :! "idle" :$ "{% &idle %}"
    | Route("GET /eof") : MpvPropertyGet("eof-reached") :! "eof" :$ "{% &eof %}"

    | Route("POST /delix/{#ix#}") {
        : MpvCommand("playlist-remove", "{ix}")
        & fredir("/pls#{% :ix %}");
    }

    | Route("POST /plyix/{#ix#}") { 
        : MpvCommand("playlist-play-index", "{ix}") 
        & reg("no") : MpvPropertySet("pause")
        & fredir("/pls#{% :ix %}");
    }

    | ExactRoute("GET /pfl") : tpl(t"profiler-list.html") {
        |~ "items" : ProfileByHeaviest("Profile") : ["Profile"] : tpl(t"profiler-item.html");
    }

    & DisableProfiler();
}; 

<<"Playback Controls">> : MpvPropertyGet("media-title") :! "mediatitle" : tpl(t"mp-playback-controls.html") {
    |~ "playpause" : <"@ Play Pause Button">
    |~ "position" : tpl(t"mp-playback-position.html") { | <"@ Position Bar">; }
    |~ "volume" : tpl(t"mp-volume-slider.html") { | <"@ Volume Bar">;  }
};

<<"Play Pause Button">> : MpvPropertyGet("pause") {
    :~ "no" { : tpl(t"mp-pause-button.html") }
    | tpl(t"mp-resume-button.html");
};

<<"Volume Bar">> : MpvPropertyGet("ao-volume") :! "volumelevel" : tpl(t"levelbar.html");
<<"Position Bar">> : MpvPropertyGet("percent-pos") :! "position" : tpl(t"positionbar.html");

<<"Append to End of Queue">> {
    : SafePathJoin(toplay = ["{rootdir}", "{urlremainder}"]) : MpvCommand("loadfile", "{toplay}", "append-play")
    & Register("yes") : MpvPropertySet("fullscreen");

};

<<"Insert after Current">> {
    : SafePathJoin(toplay = ["{rootdir}", "{urlremainder}"]) : MpvCommand("loadfile", "{toplay}", "insert-next-play")
    & Register("yes") : MpvPropertySet("fullscreen");

};

<<"Replace Queue">> {
    : SafePathJoin(toplay = ["{rootdir}", "{urlremainder}"]) : MpvCommand("loadfile", "{toplay}", "replace")
    & Register("yes") : MpvPropertySet("fullscreen");

};

<<"Desktop">> : tpl(t"desktop.html");

<<"Explorer">> 
    : SafePathJoin(explore = ["{rootdir}", "{urlremainder}"]) 
    : Info() {
        |$ "Path not found";
        :? "type" :~ "dir" : <"@ Directory Listing">;
    };

<<"Directory Listing">> : tpl(t"dirlisting.html") {
    |~ "breadcrumbs" { :? "urlremainder" : Breadcrumbs("Path Breadcrumbs") : ["Path Breadcrumbs"] : tpl(t"205-breadcrumb.html"); }
    |~ "members" :? "explore" : Dir("Visible Directory Members") {
        : ["Visible Directory Members"] : Info("onlypath", "onlyname") : tpl(t"subdir.html");
        | ["Visible Directory Members"] : Info("onlypath", "onlyname") : NewGuid() :! "fileguid" : tpl(t"subfile.html");
    };
};

<<"Directory Thumbnail">> : SafePathJoin(thumbdir = ["{rootdir}", "{urlremainder}"]) : Info() {
    |$ "Directory not found";
    :? "type" :~ "dir" : tpl(t"thumbnail-dir.html");
};

<<"File Thumbnail">> : SafePathJoin(thumbfile = ["{rootdir}", "{urlremainder}"]) : Info() {
    |$ "File not found";
    : AtomicMetadata() {
         : tpl(t"thumbnail-file.html") {
            |~ "picture" : PictureMetadata("Pictures") {
                :! "picture64" : tpl(t"thumbnail-picture.html");
                | tpl(t"thumbnail-icon.html");
            }
            |~ "performers" : PerformerMetadata("Performers") : ["Performers"] :! "performer" :$ "{% &performer %}";
         };
         | tpl(t"thumbnail-unsupported.html");
    };
};